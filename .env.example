# Bright Data Web Unlocker credentials — copy this file to `.env` and fill in.
# Create a Web Unlocker zone in the Bright Data Control Panel, then:
#   BRIGHTDATA_API_KEY   -> Control Panel > Account Settings > API key
#   BRIGHTDATA_UNLOCKER_ZONE -> the name you gave your Web Unlocker zone
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
