{
  "name": "Car Deal Finder",
  "dataColors": [
    "#2a78d6", "#eb6834", "#1baf7a", "#eda100",
    "#e87ba4", "#008300", "#4a3aa7", "#e34948"
  ],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#2a78d6",
  "center": "#f0efec",
  "minimum": "#e34948",
  "null": "#c3c2b7",
  "hyperlink": "#2a78d6",
  "visitedHyperlink": "#4a3aa7",
